---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        <!-- Social -->
        {% if page.social %}
          <div class="social">
            <div class="contact-icons">{% include social.liquid %}</div>
            <div class="contact-note">{{ site.contact_note }}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    {% if page.current_questions %}
      <section class="home-current-questions" aria-labelledby="current-questions-heading">
        <span class="academic-overview__eyebrow">Open directions</span>
        <h2 id="current-questions-heading">Current questions</h2>
        <ol class="current-questions-list">
          {% for question in page.current_questions %}
            <li>
              <span class="current-question__number" aria-hidden="true">0{{ forloop.index }}</span>
              <div>
                <h3>{{ question.title | markdownify | remove: '<p>' | remove: '</p>' }}</h3>
                <p>{{ question.description | markdownify | remove: '<p>' | remove: '</p>' }}</p>
              </div>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}

    <div class="row academic-overview">
      {% if page.education %}
        <div class="col-md-6">
          <section class="academic-overview__section">
            <span class="academic-overview__eyebrow">Background</span>
            <h2>Education</h2>
            <ul class="ul-edu fa-ul">
              {% for eItem in page.education.courses %}
                <li>
                  <i class="fa-li fas fa-graduation-cap"></i>
                  <div class="description">
                    <div class="course">
                      {{ eItem.course | markdownify | remove: '<p>' | remove: '</p>' }}
                      <span class="course-year">{{ eItem.year }}</span>
                    </div>
                    <div class="institution">{{ eItem.institution | markdownify | remove: '<p>' | remove: '</p>' }}</div>
                  </div>
                </li>
              {% endfor %}
            </ul>
          </section>
        </div>
      {% endif %}
      {% if page.interests %}
        <div class="col-md-6">
          <section class="academic-overview__section">
            <span class="academic-overview__eyebrow">Current focus</span>
            <h2>Research Interests</h2>
            <ul class="ul-interests">
              {% for interest in page.interests %}
                <li>{{ interest | markdownify | remove: '<p>' | remove: '</p>' }}</li>
              {% endfor %}
            </ul>
          </section>
        </div>
      {% endif %}
    </div>

    <!-- Selected publications -->
    {% if page.selected_papers %}
      <section class="home-selected-publications" aria-labelledby="selected-publications-heading">
        <div class="home-selected-publications__heading">
          <div>
            <span class="academic-overview__eyebrow">Research output</span>
            <h2 id="selected-publications-heading">Selected publications</h2>
          </div>
          <div class="selected-publications-controls" role="group" aria-label="Selected publication navigation">
            <button type="button" data-selected-publications-direction="-1" aria-label="Previous selected publications">←</button>
            <button type="button" data-selected-publications-direction="1" aria-label="Next selected publications">→</button>
          </div>
        </div>
        <a class="selected-publications-view-all" href="{{ '/research/' | relative_url }}">View all publications →</a>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <section class="home-news">
        <span class="academic-overview__eyebrow">Updates</span>
        <h2>
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>

{% if page.selected_papers %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var section = document.querySelector('.home-selected-publications');
      var scroller = section ? section.querySelector('.selected-publications-scroll') : null;
      var controls = section ? section.querySelectorAll('[data-selected-publications-direction]') : null;

      if (!scroller || !controls || !controls.length) return;

      var updateControls = function () {
        var edgeTolerance = 16;
        var atStart = scroller.scrollLeft <= edgeTolerance;
        var atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - edgeTolerance;

        controls.forEach(function (control) {
          var direction = Number(control.dataset.selectedPublicationsDirection);
          control.disabled = direction < 0 ? atStart : atEnd;
        });
      };

      controls.forEach(function (control) {
        control.addEventListener('click', function () {
          var direction = Number(control.dataset.selectedPublicationsDirection);
          var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          scroller.scrollBy({ left: direction * scroller.clientWidth * 0.82, behavior: reduceMotion ? 'auto' : 'smooth' });
        });
      });

      scroller.addEventListener('scroll', updateControls, { passive: true });
      window.addEventListener('resize', updateControls);
      updateControls();
    });
  </script>
{% endif %}
