---
layout: default
---
{% assign archive = page.archive %}
{% assign archive_version = archive.version_id | default: archive.current_version %}
<link rel="stylesheet" href="{{ '/assets/css/paper-archive.css' | relative_url }}">

<article class="paper-archive" aria-labelledby="paper-archive-title">
  <nav class="paper-archive__breadcrumbs" aria-label="Paper archive navigation">
    <a href="{{ '/research/' | relative_url }}">Research</a>
    <span aria-hidden="true">/</span>
    <a href="{{ '/papers/' | relative_url }}">Paper archive</a>
  </nav>

  <header class="paper-archive__header">
    <p class="paper-archive__eyebrow">Personal paper archive</p>
    <h1 id="paper-archive-title" class="paper-archive__title">{{ archive.title | escape }}</h1>
    <ul class="paper-archive__authors" aria-label="Authors">
      {% for author in archive.authors %}
        <li class="paper-archive__author">{{ author | escape }}</li>
      {% endfor %}
    </ul>
    <p class="paper-archive__publication">
      {% if archive.journal and archive.journal != blank %}{{ archive.journal | escape }}<span aria-hidden="true"> · </span>{% endif %}
      <span class="paper-archive__year">{{ archive.year | escape }}</span>
    </p>

    <div class="paper-archive__downloads" aria-label="Paper files">
      <a class="paper-archive__pdf" href="{{ archive.pdf_url | escape }}">Read PDF</a>
      <a href="{{ archive.bib_url | escape }}" download>Download BibTeX</a>
      {% if archive.doi and archive.doi != blank %}
        <a href="https://doi.org/{{ archive.doi | escape }}">Journal article (DOI)</a>
      {% endif %}
      {% if archive.arxiv and archive.arxiv != blank %}
        <a href="https://arxiv.org/abs/{{ archive.arxiv | escape }}">arXiv record</a>
      {% endif %}
    </div>

    <p class="paper-archive__record">
      Archive version {{ archive_version | remove_first: 'v' | escape }}.
      {% if archive.archived_on %}
        Archived <time datetime="{{ archive.archived_at | escape }}">{{ archive.archived_on | date: '%-d %B %Y' }}</time>
        {% if archive.archive_timezone == 'America/Los_Angeles' %}
          <span title="{{ archive.archive_timezone | escape }}">(Pacific time)</span>.
        {% elsif archive.archive_timezone %}
          ({{ archive.archive_timezone | escape }}).
        {% else %}.
        {% endif %}
      {% endif %}
      {% if archive.is_version %}
        {% assign archive_landing_path = '/papers/' | append: archive.slug | append: '/' %}
        <a href="{{ archive_landing_path | relative_url }}">Latest archive record</a>.
      {% endif %}
    </p>
  </header>

  <section class="paper-archive__section" aria-labelledby="paper-archive-abstract">
    <h2 id="paper-archive-abstract">Abstract</h2>
    <div class="paper-archive__abstract">
      <p>{{ archive.abstract | escape | newline_to_br }}</p>
    </div>
  </section>

  <section class="paper-archive__section" aria-labelledby="paper-archive-versions">
    <h2 id="paper-archive-versions">Archive history</h2>
    <p class="paper-archive__explanation">These dates record when copies were added to this archive, not when the paper was first written, posted or published. Archive version numbers refer only to the copies stored here.</p>
    <ol class="paper-archive__versions">
      {% assign archive_versions = archive.versions | reverse %}
      {% for version in archive_versions %}
        <li class="paper-archive__version">
          <h3>
            <a href="{{ version.html_url | escape }}">Archive version {{ version.id | remove_first: 'v' | escape }}</a>
            {% if version.id == archive.current_version %}
              <span class="paper-archive__current">{% if archive.is_version %}This archived copy{% else %}Latest archived copy{% endif %}</span>
            {% endif %}
          </h3>
          <p class="paper-archive__version-date">
            Archived <time datetime="{{ version.archived_at | escape }}">{{ version.archived_on | date: '%-d %B %Y' }}</time>
            {% if version.archive_timezone == 'America/Los_Angeles' %}
              <span title="{{ version.archive_timezone | escape }}">(Pacific time)</span>
            {% elsif version.archive_timezone %}
              ({{ version.archive_timezone | escape }})
            {% endif %}
          </p>
          {% if version.note and version.note != blank %}<p>{{ version.note | escape }}</p>{% endif %}
          <p class="paper-archive__version-links">
            <a href="{{ version.pdf_url | escape }}" aria-label="Read PDF of archive version {{ version.id | remove_first: 'v' | escape }}">PDF</a>
            <span aria-hidden="true"> · </span>
            <a href="{{ version.bib_url | escape }}" download aria-label="Download BibTeX for archive version {{ version.id | remove_first: 'v' | escape }}">BibTeX</a>
          </p>
          {% if version.sha256 and version.sha256 != blank %}
            <details class="paper-archive__checksum">
              <summary>File checksum (SHA-256)</summary>
              <code>{{ version.sha256 | escape }}</code>
            </details>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </section>

  <section class="paper-archive__section" aria-labelledby="paper-archive-citation">
    <h2 id="paper-archive-citation">Citation</h2>
    <p><a href="{{ archive.bib_url | escape }}" download>Download the BibTeX citation</a>.</p>
    <pre class="paper-archive__bibtex"><code>{{ archive.bibtex | escape }}</code></pre>
  </section>
</article>
