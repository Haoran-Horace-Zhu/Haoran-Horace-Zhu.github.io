{% if page.archive %}
  {% assign archive_metadata = page.archive %}
  {% assign archive_journal = archive_metadata.journal | remove: ' (to appear)' | strip %}
  {% assign archive_journal_kind = archive_journal | downcase %}
  <meta name="citation_title" content="{{ archive_metadata.title | escape }}">
  {% for author in archive_metadata.authors %}
    <meta name="citation_author" content="{{ author | escape }}">
  {% endfor %}
  <meta name="citation_publication_date" content="{{ archive_metadata.year | escape }}">
  {% if archive_journal != blank and archive_journal_kind != 'preprint' %}
    <meta name="citation_journal_title" content="{{ archive_journal | escape }}">
  {% endif %}
  <meta name="citation_pdf_url" content="{{ archive_metadata.pdf_url | escape }}">
  <meta name="citation_abstract_html_url" content="{{ archive_metadata.canonical_url | escape }}">
  {% if archive_metadata.doi and archive_metadata.doi != blank %}
    <meta name="citation_doi" content="{{ archive_metadata.doi | escape }}">
  {% endif %}
  {% if archive_metadata.arxiv and archive_metadata.arxiv != blank %}
    <meta name="citation_arxiv_id" content="{{ archive_metadata.arxiv | escape }}">
  {% endif %}
  {% capture archive_schema %}
  {
    "@context": "https://schema.org",
    "@type": "ScholarlyArticle",
    "@id": {{ archive_metadata.canonical_url | append: '#article' | jsonify }},
    "name": {{ archive_metadata.title | jsonify }},
    "headline": {{ archive_metadata.title | jsonify }},
    "url": {{ archive_metadata.canonical_url | jsonify }},
    "inLanguage": "en",
    "description": {{ archive_metadata.abstract | jsonify }},
    "abstract": {{ archive_metadata.abstract | jsonify }},
    "author": [
      {% for author in archive_metadata.authors %}
        { "@type": "Person", "name": {{ author | jsonify }} }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    "version": {{ archive_metadata.version_id | default: archive_metadata.current_version | jsonify }},
    "encoding": {
      "@type": "MediaObject",
      "encodingFormat": "application/pdf",
      "contentUrl": {{ archive_metadata.pdf_url | jsonify }}{% if archive_metadata.sha256 and archive_metadata.sha256 != blank %},
      "sha256": {{ archive_metadata.sha256 | jsonify }}{% endif %}
    }{% if archive_journal != blank and archive_journal_kind != 'preprint' %},
    "isPartOf": { "@type": "Periodical", "name": {{ archive_journal | jsonify }} }{% endif %}{% if archive_metadata.doi and archive_metadata.doi != blank %},
    "identifier": { "@type": "PropertyValue", "propertyID": "DOI", "value": {{ archive_metadata.doi | jsonify }} }{% endif %}
  }
  {% endcapture %}
  <script type="application/ld+json">{{ archive_schema | strip | replace: '<', '\u003c' }}</script>
{% endif %}
